{
  "name": "EarthVision Enterprise",
  "install": "bash scripts/cloud-install.sh",
  "terminals": [
    {
      "name": "api",
      "command": "cd backend && source .venv/bin/activate && python run.py",
      "description": "FastAPI backend on http://0.0.0.0:8000 (SQLite)"
    },
    {
      "name": "web",
      "command": "cd frontend && npm run dev -- --host 0.0.0.0 --port 5173",
      "description": "Vite Light Explorer on http://0.0.0.0:5173"
    }
  ],
  "ports": [
    { "name": "api", "port": 8000 },
    { "name": "web", "port": 5173 }
  ]
}
