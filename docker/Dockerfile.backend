FROM python:3.12-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    gdal-bin libgdal-dev g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY backend/requirements.txt .
# Host-shared RS/GIS stack is in requirements.txt (sateye-rs-2026.10). Do not
# install competing geospatial wheels inside plugin zips.
RUN pip install --no-cache-dir -r requirements.txt \
    || pip install --no-cache-dir fastapi uvicorn[standard] pydantic pydantic-settings \
       sqlalchemy[asyncio] alembic asyncpg aiosqlite python-jose[cryptography] \
       'passlib[bcrypt]' bcrypt==4.2.1 python-multipart httpx loguru redis \
       shapely pyproj numpy scipy pillow rasterio scikit-learn scikit-image \
       opencv-python-headless geopandas pyogrio xarray rioxarray pyshp \
       openpyxl reportlab aiofiles orjson email-validator greenlet tenacity

COPY backend/ .
# Image default publishers: EMPTY (fail-closed). Never bake preview-dev into production trust.
# Preview overrides via EV_PACK_PUBLISHERS → approved_publishers.preview.json mount.
COPY tools/publishers/approved_publishers.image_default.json /app/pack_publishers/approved_publishers.json
COPY tools/manifest.json /app/tools_manifest/manifest.json
RUN mkdir -p /data/cache /data/imagery /data/uploads /data/logs /data/tool_packs/artifacts /data/tool_packs/audit /data/tool_packs/staging /data/tool_packs/publishers

# Docker-safe Tool Pack defaults. Production compose MUST set EV_PACK_PUBLISHERS to a
# volume allowlist without preview-dev, and EV_PACK_TRUST_PROFILE=production.
ENV EV_RUNTIME_PINS=/data/tool_packs/runtime_pins.json \
    EV_ARTIFACTS_ROOT=/data/tool_packs/artifacts \
    EV_TOOL_PACKS_ROOT=/data/tool_packs \
    EV_PACK_PUBLISHERS=/app/pack_publishers/approved_publishers.json \
    EV_PACK_TRUST_PROFILE=production \
    EV_TOOLS_MANIFEST=/app/tools_manifest/manifest.json \
    EV_PACK_REQUIRE_SIGNATURE=1 \
    PYTHONUNBUFFERED=1
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "3", "--timeout-keep-alive", "75"]
