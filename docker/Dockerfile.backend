FROM python:3.13-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gdal-bin libgdal-dev g++ tesseract-ocr \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ ./backend/
COPY config/ ./config/

ENV PYTHONPATH=/app/backend
ENV PYTHONUNBUFFERED=1

RUN mkdir -p /app/cache/imagery /app/cache/scenes /app/uploads /app/logs

EXPOSE 8000

ENV UVICORN_WORKERS=4

CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port 8000 --app-dir /app/backend --workers ${UVICORN_WORKERS:-4} --timeout-keep-alive 75 --limit-concurrency 80"]
