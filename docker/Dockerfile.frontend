FROM node:22-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json* ./
# Harden against transient registry drops (ECONNRESET) on production hosts.
RUN npm config set fetch-retries 5 \
    && npm config set fetch-retry-mintimeout 20000 \
    && npm config set fetch-retry-maxtimeout 120000 \
    && npm config set fetch-timeout 300000 \
    && (npm ci --no-audit --no-fund || npm ci --no-audit --no-fund || npm install --no-audit --no-fund)
COPY frontend/ .
ENV VITE_API_URL=/api/v1
# Bust stale layer caches when forcing a production frontend rebuild.
ARG FRONTEND_BUILD_ID=dev
RUN mkdir -p /app/public \
    && echo "$FRONTEND_BUILD_ID" > /app/public/build-id.txt \
    && npm run build

FROM nginx:1.27-alpine
COPY deployment/nginx.frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
