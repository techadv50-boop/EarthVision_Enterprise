FROM node:22-alpine AS builder

WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
# Bust stale Dokploy layer cache when only login/nginx files change.
ARG SATPASS_BUILD_ID=login-fix-2
RUN npm run build && printf '%s\n' "$SATPASS_BUILD_ID" > /app/dist/satpass-build.txt

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY docker/nginx-frontend.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
