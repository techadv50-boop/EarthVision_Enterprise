FROM node:22-alpine AS builder

WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM nginx:alpine
RUN mkdir -p /var/cache/nginx/celestrak && chown -R nginx:nginx /var/cache/nginx
COPY --from=builder /app/dist /usr/share/nginx/html
COPY docker/nginx-frontend.conf /etc/nginx/conf.d/default.conf
COPY docker/nginx-celestrak-cache.conf /etc/nginx/conf.d/00-celestrak-cache.conf
EXPOSE 80
