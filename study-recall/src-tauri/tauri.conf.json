{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Study Recall",
  "version": "1.1.1",
  "identifier": "com.studyrecall.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Study Recall",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; media-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Study Recall",
    "shortDescription": "Offline study, oral recall, and written examinations.",
    "longDescription": "A local desktop application for organizing study material, practicing oral recall, and taking written examinations. Notes and recordings stay on this computer.",
    "resources": {
      "resources/speech/": "speech/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
