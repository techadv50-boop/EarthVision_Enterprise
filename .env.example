# SAT EYE — Offline Earth Observation
APP_NAME=SAT EYE
APP_VERSION=1.0.0
DEBUG=true
OFFLINE_MODE=true
SECRET_KEY=sat-eye-offline-local-secret-key-32chars!
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=365

# Local SQLite (default for offline PC install)
DATABASE_URL=sqlite+aiosqlite:///./sateye.db

# CORS for local UI
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://localhost:8080"]

# Storage (all local)
IMAGERY_CACHE_DIR=./cache/imagery
SCENE_CACHE_DIR=./cache/scenes
UPLOAD_DIR=./uploads
OFFLINE_DATA_DIR=./offline_data
MAX_UPLOAD_SIZE_MB=2000

# Leave blank — SAT EYE offline does not use Cesium Ion / Copernicus / Stripe
CESIUM_ION_TOKEN=
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
