# SAT EYE — Server / field deployment
APP_NAME=SAT EYE
APP_VERSION=1.0.0
DEBUG=true

# Data stays on this server (no Copernicus / Ion). Login required for field users.
OFFLINE_MODE=true
REQUIRE_LOGIN=true
CORS_ALLOW_ALL=true
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Master code to reset ANY client account password
MASTER_RESET_CODE=NTZHSS

SECRET_KEY=sat-eye-offline-local-secret-key-32chars!
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Local SQLite (shared server database)
DATABASE_URL=sqlite+aiosqlite:///./sateye.db

# Used only when CORS_ALLOW_ALL=false
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080"]

# Storage (all on this server — accessible to field clients via the UI/API)
IMAGERY_CACHE_DIR=./cache/imagery
SCENE_CACHE_DIR=./cache/scenes
UPLOAD_DIR=./uploads
OFFLINE_DATA_DIR=./offline_data
MAX_UPLOAD_SIZE_MB=2000

# Leave blank for offline/server mode
CESIUM_ION_TOKEN=
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
