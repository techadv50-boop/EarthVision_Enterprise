# Application
APP_NAME=EarthVision Enterprise
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=change-me-to-a-secure-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL + PostGIS for production)
DATABASE_URL=postgresql+asyncpg://earthvision:earthvision@localhost:5432/earthvision
# Development fallback (SQLite)
# DATABASE_URL=sqlite+aiosqlite:///./earthvision.db

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Copernicus Data Space Ecosystem
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
COPERNICUS_REDIRECT_URI=http://localhost:5173/auth/copernicus/callback
COPERNICUS_AUTH_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/auth
COPERNICUS_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
COPERNICUS_API_URL=https://catalogue.dataspace.copernicus.eu/odata/v1

# Storage
IMAGERY_CACHE_DIR=./cache/imagery
SCENE_CACHE_DIR=./cache/scenes
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=500

# Cesium Ion (optional - for terrain/imagery)
CESIUM_ION_TOKEN=

# Stripe (billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
