# SATEYE PREVIEW only — copy to .env.preview on the preview host.
# NEVER point these at production DB/volumes/secrets.

PREVIEW_POSTGRES_PASSWORD=preview-db-pass-change-me
PREVIEW_SECRET_KEY=preview-secret-key-change-me-32chars!!
PREVIEW_ADMIN_EMAIL=preview-admin@xdgen.com
PREVIEW_ADMIN_PASSWORD=PreviewOnly123
PREVIEW_MASTER_PASSWORD=PreviewOnly123
PREVIEW_CORS_ORIGINS=["https://sateye-preview.xdgen.com","http://127.0.0.1:8202"]

# Optional EO providers (safe to leave empty for UI smoke tests)
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=
CESIUM_ION_TOKEN=
