{
  "plugin_id": "optical_true_color",
  "tool_id": "optical_true_color",
  "label": "True Color (Optical)",
  "description": "Optical-only true color RGB composite from OSINT band recipes (e.g. Sentinel-2 B04/B03/B02). Export GeoTIFF or map JPEG at 300/600 DPI with north arrow and scale bar.",
  "ui_strategy": "sandboxed_iframe",
  "entry_html": "ui/panel.html",
  "frontend_slot": "right_analysis_panel",
  "map_presentation": "prefer_scene_tiles",
  "requires_host_capabilities": [
    "host.math.numpy",
    "host.raster.rasterio",
    "host.raster.pillow",
    "host.analytics.composites",
    "host.map.prefer_scene_tiles",
    "host.raster.geotiff_export"
  ],
  "permissions": [
    "synthetic_data",
    "ui.slot.right_analysis_panel",
    "host.sdk.read_meta",
    "host.sdk.read_capabilities",
    "host.sdk.read_scene",
    "host.sdk.render_true_color",
    "host.sdk.clear_map_layer",
    "host.sdk.export_geotiff",
    "host.sdk.export_map_jpeg",
    "host.sdk.set_analysis_result",
    "host.sdk.read_analysis_result"
  ],
  "host_sdk": {
    "protocol": 1,
    "version": ">=1.4.0,<2",
    "react": "forbidden",
    "leaflet": "forbidden",
    "remote_bundle": false,
    "execution": "sandboxed_iframe_srcdoc"
  },
  "optical_only": true,
  "applicable_satellites": [
    "SENTINEL-2",
    "LANDSAT-8",
    "LANDSAT-9",
    "LANDSAT-7",
    "MODIS"
  ],
  "notes": "Active only for optical scenes. Map presentation is Host-owned (prefer_scene_tiles). Plugin calls host.renderTrueColor / host.clearMapLayer / exports — never Leaflet."
}
